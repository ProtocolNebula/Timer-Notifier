{
  "manifest_version": 3,
  "name": "Quarter Hour Reminder",
  "version": "1.0.0",
  "description": "Send configurable reminders via Firefox notifications on a repeating schedule.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "Quarter Hour Reminder",
    "default_popup": "index.html"
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css",
        "app.js",
        "sounds/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "applications": {
    "gecko": {
      "id": "timer-notifier@example.com"
    }
  }
}
